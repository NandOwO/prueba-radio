# Copia este archivo a .env.production y cambia todos los valores de ejemplo.

# Base de datos (usada por postgres y por la API)
POSTGRES_USER=pulsofm
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=pulsofm
DATABASE_URL=postgresql://pulsofm:cambia-esta-clave@postgres:5432/pulsofm

# Sesiones (al menos 16 caracteres, aleatorio)
JWT_SECRET=cambia-por-un-secreto-largo-y-aleatorio
SESSION_TTL_HOURS=12

# ERP real (ver docs/erp-integration.md)
ERP_MODE=gymerp
ERP_BASE_URL=https://erp.gimnasio.local/api/v1
ERP_API_KEY=
ERP_WEBHOOK_SECRET=
ERP_SYNC_ENABLED=true

# Música (búsqueda) y cuota diaria
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=9000
SEARCH_CACHE_HOURS=24

# Roles por ID de socio del ERP (provisional hasta el panel de administración)
DISPLAY_MEMBER_IDS=
STAFF_MEMBER_IDS=
ADMIN_MEMBER_IDS=

# Puerto de la web en el host (por defecto 8080)
WEB_PORT=8080
