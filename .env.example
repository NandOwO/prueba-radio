# Base de datos
POSTGRES_USER=pulsofm
POSTGRES_PASSWORD=pulsofm
POSTGRES_DB=pulsofm
DATABASE_URL=postgresql://pulsofm:pulsofm@localhost:5432/pulsofm

# Redis (opcional en fase 1)
REDIS_URL=redis://localhost:6379

# ERP (ver docs/erp-integration.md)
ERP_BASE_URL=
ERP_API_KEY=
ERP_WEBHOOK_SECRET=

# YouTube Data API v3 (ver docs/plan-implementacion.md, sección 3)
YOUTUBE_API_KEY=
# Límite diario propio (YouTube da 10 000 unidades). Margen de seguridad.
YOUTUBE_DAILY_QUOTA=9000
SEARCH_CACHE_HOURS=24

# API de PulsoFM
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-16-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_HOURS=12
PORT=3000

# ERP: 'fake' usa datos de prueba (apps/api/fixtures); 'gymerp' usa el ERP real
ERP_MODE=fake
ERP_SYNC_ENABLED=false

# Roles por ID de socio del ERP de prueba (ver README, sección de cuentas de prueba)
DISPLAY_MEMBER_IDS=DISPLAY-01
STAFF_MEMBER_IDS=M-10601
ADMIN_MEMBER_IDS=M-10482
