generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  externalId   String    @unique
  username     String    @unique
  name         String
  role         String    @default("member")
  status       String    @default("active")
  lastSyncedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  sessions     Session[]
  requests     Request[]

  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model Track {
  id              String   @id @default(cuid())
  provider        String
  providerTrackId String
  title           String
  artist          String
  durationMs      Int
  coverUrl        String?
  cachedAt        DateTime @default(now())
  requests        Request[]

  @@unique([provider, providerTrackId])
  @@map("tracks")
}

model SearchCache {
  query    String   @id
  trackIds Json
  cachedAt DateTime @default(now())

  @@map("search_cache")
}

model QuotaUsage {
  day   String @id
  units Int    @default(0)

  @@map("quota_usage")
}

model Request {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track     @relation(fields: [trackId], references: [id])
  status    String    @default("queued")
  position  Int
  reason    String?
  decidedBy String?
  createdAt DateTime  @default(now())
  playedAt  DateTime?

  @@index([status, position])
  @@index([userId, createdAt])
  @@map("requests")
}
